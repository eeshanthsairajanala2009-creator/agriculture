# ==============================================================================
# KrishiSetu Nexus - Supabase Cloud PostgreSQL Configuration
# ==============================================================================

# 1. Supabase Project URL and API Keys (from Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Supabase PostgreSQL Connection String (RECOMMENDED for DDL Migrations & RLS)
# Retrieve from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Mode Direct (Port 5432):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
# Mode Transaction Pooler (Port 6543, for IPv4 / serverless):
# DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 3. Alternative: Let the runner auto-build the URI using Project Ref & Password
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

# 4. Alternative: Supabase Management API Token (Does not require database password)
# Generate from: https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
