{
  "name": "krishisetu-nexus",
  "version": "1.0.0",
  "description": "KrishiSetu Nexus - Agricultural AI Platform (Supabase PostgreSQL, Express Backend & React Vite Frontend)",
  "main": "scripts/migrate.js",
  "scripts": {
    "start": "npm --prefix backend start",
    "start:backend": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "start:frontend": "npm --prefix krishisetu-frontend run dev",
    "build:frontend": "npm --prefix krishisetu-frontend run build",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "migrate:dry-run": "node scripts/migrate.js --dry-run",
    "migrate:force": "node scripts/migrate.js --force",
    "test:schema": "node scripts/validate_schema.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "dotenv": "^18.0.6",
    "pg": "^8.23.1"
  }
}
