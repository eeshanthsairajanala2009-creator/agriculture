# ==============================================================================
# KrishiSetu Nexus - Backend Environment Variables Template
# ==============================================================================

# Server Network Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# URLs Architecture (Separate Internal/Dev URLs + Single Unified Public URL)
# ------------------------------------------------------------------------------
# 1. Single Canonical Public URL (Accessible to all farmers, users & mobile clients)
#    In production: set to your domain (e.g., https://krishisetu.nexus.app)
#    In local development: http://localhost:3000 (or http://<your-local-ip>:3000 for LAN testing)
PUBLIC_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5000/api

# 2. Separate Internal & Local URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
# In production (Render), replace with your actual frontend URL:
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://krishisetu-app.onrender.com

# ------------------------------------------------------------------------------
# Supabase Cloud PostgreSQL Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key (CONFIDENTIAL: Never share with browser or mobile clients)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Connection String (from Supabase Dashboard -> Project Settings -> Database)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

# ------------------------------------------------------------------------------
# Security & Auth Tokens
# ------------------------------------------------------------------------------
JWT_SECRET=your-jwt-secret-key-at-least-32-characters
SESSION_SECRET=your-session-secret-key

# ------------------------------------------------------------------------------
# Storage & Media Bucket URLs
# ------------------------------------------------------------------------------
SUPABASE_STORAGE_URL=https://your-project-ref.supabase.co/storage/v1/object/public
STORAGE_BUCKET_CROP_IMAGES=crop-observations
STORAGE_BUCKET_AUDIO=farmer-voice-notes
STORAGE_BUCKET_LABELS=product-labels
